								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"proposal_id\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/contracts",
							"host": ["{{baseUrl}}"],
							"path": ["contracts"]
