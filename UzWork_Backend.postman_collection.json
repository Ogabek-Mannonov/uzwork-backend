				},
				{
					"name": "Get My Contracts",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/contracts/my",
							"host": ["{{baseUrl}}"],
							"path": ["contracts", "my"]
						}
					}
				}
			]
		},
		{
			"name": "Reviews",
			"item": [
