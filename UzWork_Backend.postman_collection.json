						"body": {
							"mode": "raw",
							"raw": "{\n  \"bio\": \"Experienced developer\",\n  \"location\": \"Tashkent\",\n  \"hourly_rate\": 25,\n  \"skills\": [\"React\", \"Node.js\"]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/profiles/me",
